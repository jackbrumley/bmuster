# Path to the SQLite database file.
DATABASE_PATH=./data/bmuster.db
# 32 random bytes in base64: openssl rand -base64 32
SECRETS_KEY=
# Folder of agent builds: <version>/<target>/bmuster-agent[.exe]
RELEASES_PATH=./data/releases

# Optional, for unattended installs: the first admin, created at start-up only
# while the server has no users (then /setup is skipped). Never changes an
# existing account. Remove them once the server is set up.
# BMUSTER_ADMIN_EMAIL=
# BMUSTER_ADMIN_PASSWORD=
# BMUSTER_ADMIN_NAME=Administrator

# Optional, set by the server installer: while the server has no users, turn
# on local network mode at start-up (HTTPS with the server's own certificate).
# After setup, Settings > Security owns the setting. The only value is on.
# BMUSTER_LOCAL_NETWORK_MODE=on

# Optional: the nightly database snapshot, written to backups/ beside the
# database (bmuster-YYYY-MM-DD.db). The time is HH:MM in the server's time
# zone (TZ); 03:00 when left out. Keep is how many daily snapshots to keep;
# 14 when left out, 0 turns snapshots off.
# BMUSTER_BACKUP_TIME=03:00
# BMUSTER_BACKUP_KEEP=14

# Launcher-owned values. Source runs leave these unset; the container sets docker.
# An installed server's launcher sets installed, its data folder (where the
# app asks the root updater for an update), its target and a readiness nonce.
# BMUSTER_DEPLOYMENT=source
# BMUSTER_UPDATE_DATA=
# BMUSTER_LAUNCHER_TARGET=
# BMUSTER_READINESS_NONCE=
