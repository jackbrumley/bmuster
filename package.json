{
	"name": "bmuster-server",
	"version": "0.4.3",
	"private": true,
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*",
		"#tests/*": "./tests/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node server.ts",
		"agent:dev": "node scripts/agent-dev.ts",
		"agent:release-local": "node scripts/agent-release-local.ts",
		"release:server-local": "node scripts/release-server.ts",
		"server:sign-update": "node scripts/server-update-sign.ts",
		"server:update-test": "node scripts/server-update-scratch-test.ts",
		"docker:local": "node scripts/docker-local.ts",
		"agent:release-key": "node scripts/agent-release-key.ts",
		"agent:sign": "node scripts/agent-sign.ts",
		"admin:reset": "node scripts/admin-reset.ts",
		"diagnostics": "node scripts/diagnostics.ts",
		"brand:icons": "node scripts/brand-icons.ts",
		"prepare": "svelte-kit sync || echo ''; git rev-parse --is-inside-work-tree >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"lint": "eslint .",
		"fmt": "prettier --write .",
		"fmt:check": "prettier --check .",
		"test": "vitest run",
		"hygiene": "node scripts/hygiene.ts && npm run deadcode && npm run duplication",
		"hygiene:docs": "node scripts/hygiene-docs.ts",
		"deadcode": "svelte-kit sync && knip",
		"duplication": "node scripts/duplication.ts",
		"verify": "node scripts/verify.ts",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@sveltejs/adapter-node": "6.0.1",
		"@sveltejs/kit": "3.1.1",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tabler/icons-svelte-runes": "3.49.0",
		"@types/better-sqlite3": "9.6.0",
		"@types/node": "26.6.5",
		"@types/ws": "8.18.2",
		"@vitejs/plugin-basic-ssl": "2.3.0",
		"@vitest/browser-playwright": "5.0.5",
		"@xterm/addon-fit": "0.11.0",
		"@xterm/addon-unicode11": "0.9.0",
		"@xterm/addon-web-links": "0.12.0",
		"@xterm/xterm": "6.0.0",
		"drizzle-kit": "0.31.11",
		"eslint": "10.13.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.23.1",
		"globals": "17.13.0",
		"jscpd": "5.4.2",
		"knip": "6.42.1",
		"playwright": "1.64.1",
		"prettier": "3.9.10",
		"prettier-plugin-svelte": "4.1.1",
		"svelte": "5.57.3",
		"svelte-check": "4.7.7",
		"typescript": "6.0.3",
		"typescript-eslint": "8.72.0",
		"vite": "8.3.6",
		"vitest": "5.0.5",
		"vitest-browser-svelte": "3.1.0"
	},
	"dependencies": {
		"@noble/hashes": "1.8.0",
		"@node-rs/argon2": "2.2.2",
		"@upyo/core": "0.6.0",
		"@upyo/smtp": "0.6.0",
		"better-sqlite3": "13.0.3",
		"drizzle-orm": "0.45.4",
		"openid-client": "6.8.9",
		"ws": "8.22.0",
		"zod": "4.6.7"
	},
	"license": "AGPL-3.0-only",
	"engines": {
		"node": ">=26"
	},
	"allowScripts": {
		"esbuild@0.18.20": true,
		"esbuild@0.25.12": true,
		"esbuild@0.28.2": true
	}
}
